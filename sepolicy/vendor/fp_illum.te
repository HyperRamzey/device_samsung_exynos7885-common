# ET715 optical fingerprint mask-layer illumination relay.
#
# WHY A *VENDOR* DOMAIN, which is the whole reason this file exists in vendor/
#   The relay needs BOTH of these, and they live on opposite sides of the
#   vendor/platform policy split:
#     * write /sys/class/lcd/panel/mask_brightness
#           -> type sysfs_lcd_writable, declared in device/samsung_slsi/
#              sepolicy/common/vendor/file.te, i.e. VENDOR. Invisible to
#              sepolicy/private/, so a platform domain gets
#              "unknown type sysfs_lcd_writable" and the build stops.
#     * dumpsys fingerprint / dumpsys power / settings put / input keyevent
#           -> settings_service, input_service, power_service,
#              fingerprint_service, system_server. All declared in
#              system/sepolicy/public/, so they ARE visible here.
#   Vendor policy sees public types and vendor types. A platform domain sees
#   public types only. Therefore the vendor partition is the only place from
#   which this daemon can be expressed at all. That is why the payload installs
#   to /vendor/bin rather than /system/bin.
#
# WHY IT NEEDS ITS OWN EXEC TYPE
#   init has NO execute permission on system_file: the platform policy grants
#   init only dir mounton, plus dir/file ioctl read getattr lock map open watch
#   watch_reads search. No execute, no entrypoint. So a stock-labelled script is
#   unrunnable by init from either /system/bin or /vendor/bin (trap 18). A
#   dedicated exec type plus init_daemon_domain() is what makes the transition
#   legal.
#
# WHY THE HAL'S OWN ILLUMINATION PATH IS NOT AN ALTERNATIVE
#   android.hardware.biometrics.fingerprint-service.samsung globs
#       /sys/devices/platform/*/decon0/fingerprint_illum
#   but this board's node is
#       /sys/devices/platform/14860000.decon_f/fingerprint_illum
#   and no decon0 platform device exists at all, so the HAL logs
#   "fingerprint illum node: NOT FOUND" every call and never lights the panel.
#   The HAL is a prebuilt vendor blob, so the glob cannot be fixed in source.
#
# FAILURE MODE, deliberately chosen
#   Every allow below is additive and none can widen another domain, so a
#   mistake fails CLOSED - illumination stops working, which is exactly where we
#   started - rather than weakening the policy or affecting boot. Do not
#   "simplify" this with blanket allows such as
#   `allow fp_illum sysfs_type:file rw_file_perms`; that is a real escalation and
#   the vendor neverallow pass may not catch it.

# Declaration shape copied from gpsd (device/samsung_slsi/sepolicy/common/vendor/
# gpsd.te), which is the working vendor-daemon precedent in this tree:
#   type gpsd, domain, netdomain;
#   type gpsd_exec, exec_type, vendor_file_type, file_type;
#   init_daemon_domain(gpsd)
# There is deliberately NO vendor_domain attribute here - it does not exist
# in this tree and checkpolicy rejects it outright:
#   ERROR 'attribute vendor_domain is not declared'
type fp_illum, domain;
type fp_illum_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(fp_illum)

# The payload is a #!/system/bin/sh script, so after init execs fp_illum_exec
# the kernel re-execs the interpreter; that transition needs to be permitted.
allow fp_illum shell_exec:file rx_file_perms;

# toybox applets the script calls: dumpsys sleep grep date settings input cut
# cat head awk test rm mkdir. All live in /system/bin as system_file. These are
# children exec'd after start-up, not init entrypoints, so execute (not
# entrypoint) is what is being requested.
allow fp_illum system_file:file rx_file_perms;

# --- panel illumination -------------------------------------------------
# sysfs_decon is deliberately r_fs_type so a write allow on it is impossible;
# the writable nodes therefore carry dedicated rw_fs_type types.
allow fp_illum sysfs_decon:dir { search getattr open read };
allow fp_illum sysfs_fingerprint_illum:file rw_file_perms;  # KNOB, arms the mask
allow fp_illum sysfs_lcd_writable:file rw_file_perms;        # LEVEL, 337 not 255

# --- inputs ------------------------------------------------------------
# ist40xx_ts edge count, column 2. This is the only usable "a finger is here"
# signal: the HAL acquire counter cannot switch the light on because the sensor
# only scans while the mask is lit, so using it would be circular.
allow fp_illum proc_interrupts:file r_file_perms;

# --- binder ------------------------------------------------------------
# The wake is not optional. With the panel asleep no frames are submitted, so
# __decon_update_regs never runs and the mask write is INERT - measured:
# actual_mask_brightness stayed 0 for 12 s with KNOB=1. Stock achieves the same
# thing with a gralloc-sourced DECON_WIN_STATE_FINGERPRINT window state that
# AOSP has no equivalent for.
binder_use(fp_illum)
allow fp_illum fingerprint_service:service_manager find;
allow fp_illum power_service:service_manager find;
allow fp_illum settings_service:service_manager find;
allow fp_illum input_service:service_manager find;
binder_call(fp_illum, system_server)

# --- private state -----------------------------------------------------
# /data/vendor/fp_illum holds relay.log, relay.pid and mask_value only. It is
# under /data/vendor rather than /data/misc so the type is unambiguous:
# vendor_data_file is public policy, whereas /data/misc has no generic label.
allow fp_illum vendor_data_file:dir { add_name create getattr mkdir open read remove_name rmdir search write };
allow fp_illum vendor_data_file:file { append create getattr map open read rename setattr unlink write };